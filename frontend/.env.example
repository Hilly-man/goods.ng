# Server-side URL of the FastAPI backend (used by SSR fetches and the /api rewrite)
API_INTERNAL_URL=http://localhost:8000
# Public site URL (canonical URLs, sitemap, structured data)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Admin console subdomain (optional). When set, the console is served at this origin and /admin on the
# main site redirects here. Local dev: http://admin.localhost:3000 (browsers resolve *.localhost automatically).
ADMIN_URL=
NEXT_PUBLIC_ADMIN_URL=
