# ---- Goods.ng API configuration (copy to .env for local development) ----
ENVIRONMENT=development            # development | test | staging | production
DATABASE_URL=postgresql+psycopg://localhost/goodsng_dev
REDIS_URL=                         # required in production, e.g. redis://localhost:6379/0
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Secrets — generate unique values per environment; production refuses to boot with dev defaults.
JWT_SECRET=change-me-64-random-chars
OTP_SECRET=change-me-random
DATA_ENCRYPTION_KEY=               # python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"

# Providers. "mock" = development/testing only (production refuses to boot with mock providers).
PAYMENT_PROVIDER=mock              # mock | paystack | flutterwave
ESCROW_PROVIDER=mock               # licensed partner adapter required before go-live
BNPL_PROVIDER=mock                 # licensed lender adapter required before go-live
BANK_DATA_PROVIDER=mock            # mock | mono (open banking for the Flex credit limit)
PAYSTACK_SECRET_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_WEBHOOK_HASH=
MOCK_PROVIDER_SECRET=mock-webhook-signing-secret
MONO_SECRET_KEY=                   # test_sk_... or live_sk_...
MONO_PUBLIC_KEY=                   # used by the Mono Connect widget in the browser
MONO_BASE_URL=https://api.withmono.com

# Storage
STORAGE_BACKEND=local              # local | s3
LOCAL_MEDIA_DIR=media
MEDIA_BASE_URL=/media              # CDN URL in production
S3_BUCKET=
S3_ENDPOINT_URL=

# Marketplace economics (defaults; admins can override in Platform Settings)
PLATFORM_COMMISSION_RATE=0.05
PROTECTION_FEE_RATE=0.015
PROTECTION_FEE_CAP=5000.00
AUTO_RELEASE_DAYS=3
